@model prjFruitbar8000WebCore.Models.Wraps.CArtistsWrap

@{
    ViewData["Title"] = "編輯創作者資訊";
}

<h1>編輯創作者資訊</h1>

<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Edit">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="FArtistId" />
            <div class="form-group">
                <label asp-for="FArtistName" class="control-label"></label>
                <input asp-for="FArtistName" class="form-control" />
                <span asp-validation-for="FArtistName" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="FArtistType" class="control-label"></label>
                <input asp-for="FArtistType" class="form-control" />
                <span asp-validation-for="FArtistType" class="text-danger"></span>
            </div>
            <div class="form-group">
                <input type="submit" value="儲存資訊" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-action="Index">回到創作者清單</a>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
