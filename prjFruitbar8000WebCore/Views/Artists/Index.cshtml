@model IEnumerable<prjFruitbar8000WebCore.Models.Wraps.CArtistsWrap>

@{
    ViewData["Title"] = "創作者清單";
}

<h1>創作者清單</h1>

<p>
    <a asp-action="Create" class="btn btn-success">新增創作者</a>
</p>

<table class="table align-middle">
    <thead>
        <tr>
            <th>@Html.DisplayNameFor(model => model.FArtistName)</th>
            <th>@Html.DisplayNameFor(model => model.FArtistType)</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@Html.DisplayFor(modelItem => item.FArtistName)</td>
                <td>@Html.DisplayFor(modelItem => item.FArtistType)</td>
                <td>
                    <a asp-action="Edit" asp-route-id="@item.FArtistId" class="btn btn-secondary">編輯</a>
                    <form asp-action="Delete" asp-route-id="@item.FArtistId" method="post" style="display: inline;">
                        <button type="submit" onclick="return confirm('確定要永久刪除這位創作者嗎？');" class="btn btn-danger">刪除</button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>
