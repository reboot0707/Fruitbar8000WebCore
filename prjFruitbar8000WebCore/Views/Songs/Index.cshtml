@model IEnumerable<prjFruitbar8000WebCore.Models.Wraps.CSongsWrap>

@{
    ViewData["Title"] = "歌曲清單";
}

<h1>歌曲清單</h1>

<p>
    <a asp-action="Create">新增曲目</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.FSongName)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.FLyrics)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.FDuration)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>
                    @Html.DisplayFor(model => item.FSongName)
                </td>
                <td>
                    @Html.DisplayFor(model => item.FLyrics)
                </td>
                <td>
                    @Html.DisplayFor(model => item.FDuration)
                </td>
                <td>
                    <a asp-action="Edit" asp-route-id="@item.FSongId">Edit</a> |
                    <a asp-action="Delete" asp-route-id="@item.FSongId">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>
