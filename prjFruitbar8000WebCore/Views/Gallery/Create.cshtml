@model prjFruitbar8000WebCore.Models.ViewModels.NewSongViewModel

@{
    ViewData["Title"] = "新曲建檔";
}

<h1>輸入新曲資訊</h1>

<hr />
<div class="row">
    <div class="col-12 col-md-6">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="form-group">
                <label asp-for="SongName" class="control-label"></label>
                <input asp-for="SongName" class="form-control" />
                <span asp-validation-for="SongName" class="text-danger"></span>
            </div>

            <div>
                <label asp-for="ArtistId"></label>
                <div class="d-flex gap-2">
                    <select asp-for="ArtistId" asp-items="Model.ArtistList" class="form-select flex-grow-1">
                        <option value="">請選擇創作者</option>
                    </select>
                    <a asp-controller="Artists" asp-action="Create" target="_blank"
                       class="btn btn-secondary flex-shrink-0">新增創作者</a>
                </div>
            </div>

            <div>
                <label asp-for="AlbumId"></label>
                <div class="d-flex gap-2">
                    <select asp-for="AlbumId" asp-items="Model.AlbumList" class="form-select flex-grow-1">
                        <option value="">請選擇專輯</option>
                    </select>
                    <a asp-controller="Albums" asp-action="Create" target="_blank"
                       class="btn btn-secondary flex-shrink-0">新增專輯</a>
                </div>
            </div>

            <div class="form-group my-2">
                <input type="submit" value="新增歌曲" class="btn btn-primary" />
                <a asp-action="Index" class="btn btn-secondary">回到列表</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
