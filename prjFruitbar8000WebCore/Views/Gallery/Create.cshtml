@model prjFruitbar8000WebCore.Models.ViewModels.GallerySongViewModel

@{
    ViewData["Title"] = "建立新曲";
}

<h2>輸入新曲資訊</h2>
<p>若有關聯多位創作者/專輯的需求, 請於建檔成功後至修改介面更新資料.</p>

<hr />
<div class="row">
    <div class="col-12 col-md-6">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="form-group">
                <label asp-for="SongName" class="control-label"></label>
                <input asp-for="SongName" class="form-control" />
                <span asp-validation-for="SongName" class="text-danger"></span>
            </div>

            <div class="form-group my-2">
                <label asp-for="SelectedArtistIdList" class="control-label"></label>
                <div class="gap-2">
                    <select asp-for="SelectedArtistIdList" asp-items="Model.OptionArtistIdList"
                            class="form-select flex-grow-1">
                    </select>
                    <a asp-controller="Artists" asp-action="Create" target="_blank" class="btn btn-success flex-shrink-0">新增創作者</a>
                </div>
                <span asp-validation-for="SelectedArtistIdList" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="SelectedAlbumIdList" class="control-label"></label>
                <div class="gap-2">
                    <select asp-for="SelectedAlbumIdList" asp-items="Model.OptionAlbumIdList"
                                class="form-select flex-grow-1">
                            <option value="">請選擇專輯</option>
                    </select>
                    <a asp-controller="Albums" asp-action="Create" target="_blank" class="btn btn-success flex-shrink-0">新增專輯</a>
                </div>
                <span asp-validation-for="SelectedAlbumIdList" class="text-danger"></span>
            </div>

            <div class="form-group my-2">
                <input type="submit" value="新增歌曲" class="btn btn-primary" />
                <a asp-action="Index" class="btn btn-secondary">回到列表</a>
            </div>
        </form>
    </div>
</div>

@* TODO: move this to common section of Views *@
@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
