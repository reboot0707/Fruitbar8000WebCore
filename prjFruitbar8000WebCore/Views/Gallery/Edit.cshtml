@model prjFruitbar8000WebCore.Models.ViewModels.GallerySongViewModel

@{
    ViewData["Title"] = "Edit";
}

<h1>樂曲資訊編輯</h1>

<hr />
<div class="row">
    <div class="col-md-6">
        <form asp-action="Edit">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="id" />
            <div class="form-group">
                <label asp-for="SongName" class="control-label"></label>
                <input asp-for="SongName" class="form-control" />
                <span asp-validation-for="SongName" class="text-danger"></span>
            </div>
            <div class="my-2">
                <label asp-for="SelectedArtistIdList"></label>
                <div class="gap-2">
                    <select asp-for="SelectedArtistIdList" asp-items="Model.SelectableArtistIdList"
                            class="form-select flex-grow-1">
                        <option value="">請選擇創作者</option>
                    </select>
                    <a asp-controller="Artists" asp-action="Create" target="_blank"
                       class="btn btn-success flex-shrink-0">新增創作者</a>
                </div>
            </div>
            <div class="my-2">
                <label asp-for="SelectedAlbumIdList"></label>
                <div class="gap-2">
                    <select asp-for="SelectedAlbumIdList" asp-items="Model.SelectableAlbumIdList"
                            class="form-select flex-grow-1">
                        <option value="">請選擇專輯</option>
                    </select>
                    <a asp-controller="Albums" asp-action="Create" target="_blank"
                       class="btn btn-success flex-shrink-0">新增專輯</a>
                </div>
            </div>
            @* <div class="form-group">
                <label asp-for="SelectableArtistIdList" class="control-label"></label>
                <input asp-for="SelectableArtistIdList" class="form-control" />
                <span asp-validation-for="SelectableArtistIdList" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="SelectableAlbumIdList" class="control-label"></label>
                <input asp-for="SelectableAlbumIdList" class="form-control" />
                <span asp-validation-for="SelectableAlbumIdList" class="text-danger"></span>
            </div> *@
            <div class="form-group my-2">
                <input type="submit" value="儲存資訊" class="btn btn-primary" />
                <a asp-action="List" class="btn btn-secondary">回到列表</a>
            </div>
        </form>
    </div>
</div>


@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
