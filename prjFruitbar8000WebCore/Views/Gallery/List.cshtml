@model IEnumerable<prjFruitbar8000WebCore.Models.ViewModels.GalleryListViewModel>

@{
    ViewData["Title"] = "所有樂曲列表";
}

<h1>所有樂曲列表</h1>

<p>
    <a asp-action="Create" class="btn btn-success">歌曲建檔</a>
</p>
<table class="table align-middle">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.SongName)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.ArtistNames)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.AlbumName)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>
                    @Html.DisplayFor(model => item.SongName)
                </td>
                <td>
                    @Html.DisplayFor(model => item.ArtistNames)
                </td>
                <td>
                    @Html.DisplayFor(model => item.AlbumName)
                </td>
                <td>
                    <a asp-action="Edit" asp-route-id="@item.id" class="btn btn-secondary">編輯</a>
                    @* <a asp-action="Details" asp-route-id="@item.id">Details</a> *@
                    <form asp-action="Delete" asp-route-id="@item.id" method="post" style="display: inline;">
                        <button type="submit" onclick="confirm('確定永久刪除?')" class="btn btn-danger">刪除</button>
                    </form>

                </td>
            </tr>
        }
    </tbody>
</table>
